#!/bin/sh
# Claude Code statusline: your existing statusline, with the radio appended.
#
#   "statusLine": { "type": "command",
#                   "command": "/path/to/cc-radio/scripts/ccradio-statusline" }
#
# Optional: the mod already shows the station in the band above the prompt.
# Use this when you would rather have it in the statusline.
#
# To keep a statusline you already had, put its command in:
#   ~/.config/ccradio/base-statusline
# Claude Code runs this without a shell, so an env var in settings.json will
# not reach us - the file is the way.
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BASE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ccradio/base-statusline"
YOUR_STATUSLINE="${CCRADIO_BASE_STATUSLINE:-}"
if [ -z "$YOUR_STATUSLINE" ] && [ -r "$BASE_FILE" ]; then
  YOUR_STATUSLINE="$(cat "$BASE_FILE")"
fi

payload="$(cat)"
if [ -n "$YOUR_STATUSLINE" ]; then
  base="$(printf '%s' "$payload" | sh -c "$YOUR_STATUSLINE" 2>/dev/null)"
else
  base=""
fi
radio="$("$ROOT/scripts/ccradio" statusline 2>/dev/null)"

if [ -n "$radio" ] && [ -n "$base" ]; then
  printf '%s  \033[2m|\033[0m  %s\n' "$base" "$radio"
else
  printf '%s%s\n' "$base" "$radio"
fi
