#!/usr/bin/env python3
"""ccradio - internet radio that plays while Claude Code works.

This file is the actuator and the brain. The mod in hooks/register.js is the
sensor: it tells us, per tab, whether a turn is in flight, whether Claude is
waiting on you, and how many subagents are running. We keep one record per
tab, decide from all of them whether music should play, and make mpv match.

Every decision is a pure function of the records (decide), and every player
command is safe to repeat (ensure_playing / ensure_paused). So it does not
matter which tab asks first, or twice, or late: they all reach the same
answer from the same facts.

All state lives outside the calling process, in a state directory, so
playback survives between Claude Code turns and across sessions.
"""

import contextlib
import fcntl
import json
import os
import random
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request

VERSION = "2.2.0"
UA = "cc-radio/%s (+https://github.com/surendranb/cc-radio)" % VERSION
VOL_STEP = 10
VOL_MAX = 130

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CURATED = os.path.join(HERE, "stations", "curated.json")

# Hardcoded last resort if curated.json is missing or corrupt.
FALLBACK = [
    {"id": "soma-groovesalad", "name": "Groove Salad", "genre": "ambient, electronic",
     "url": "https://ice2.somafm.com/groovesalad-256-mp3", "source": "SomaFM"},
    {"id": "soma-dronezone", "name": "Drone Zone", "genre": "ambient",
     "url": "https://ice2.somafm.com/dronezone-256-mp3", "source": "SomaFM"},
    {"id": "rp-main", "name": "Radio Paradise - Main Mix", "genre": "eclectic rock",
     "url": "https://stream.radioparadise.com/mp3-192", "source": "Radio Paradise"},
]


# --------------------------------------------------------------------------
# tunables (env wins, so the mod can pass userConfig through)
# --------------------------------------------------------------------------

def _env_float(name, default):
    try:
        return float(os.environ.get(name) or default)
    except ValueError:
        return default


def start_delay():
    """Seconds of work before the music earns its place. A quick answer stays silent."""
    return max(0.0, _env_float("CCRADIO_START_DELAY", 6.0))


# --------------------------------------------------------------------------
# the mic: a call or dictation takes the speakers, so the music steps aside
# --------------------------------------------------------------------------

MIC_HOLD = 6.0           # seconds the mic must stay free before the music returns
# Apps that hold the mic all day without a live call. Matched as a lowercase
# substring of the process path. Override with CCRADIO_MIC_IGNORE=a,b ("" = none).
MIC_IGNORE = ("granola",)


def mic_ignore():
    raw = os.environ.get("CCRADIO_MIC_IGNORE")
    if raw is None:
        return MIC_IGNORE
    return tuple(x.strip().lower() for x in raw.split(",") if x.strip())


def _ca_get(ca, ctypes, obj, sel, scope="glob", array=False):
    """Read one CoreAudio property: a uint32, or an array of them. None on failure."""
    class Addr(ctypes.Structure):
        _fields_ = [("sel", ctypes.c_uint32), ("scope", ctypes.c_uint32),
                    ("el", ctypes.c_uint32)]
    a = Addr(int.from_bytes(sel.encode(), "big"), int.from_bytes(scope.encode(), "big"), 0)
    n = ctypes.c_uint32(4)
    if array:
        if ca.AudioObjectGetPropertyDataSize(obj, ctypes.byref(a), 0, None,
                                             ctypes.byref(n)) != 0:
            return None
        buf = (ctypes.c_uint32 * (n.value // 4))()
    else:
        buf = ctypes.c_uint32(0)
    if ca.AudioObjectGetPropertyData(obj, ctypes.byref(a), 0, None,
                                     ctypes.byref(n), ctypes.byref(buf)) != 0:
        return None
    return list(buf) if array else buf.value


def mic_holders():
    """Paths of the processes capturing audio right now. macOS only.

    Reads CoreAudio through ctypes: no helper binary, no permission prompt,
    and it never opens the mic itself. macOS 14+ says which process holds the
    mic. Older macOS only says that somebody does, reported as "unknown".
    """
    if sys.platform != "darwin":
        return []
    try:
        import ctypes
        ca = ctypes.CDLL("/System/Library/Frameworks/CoreAudio.framework/CoreAudio")
        procs = _ca_get(ca, ctypes, 1, "prs#", array=True)
        if procs is None:            # no per-process API: ask the default mic
            dev = _ca_get(ca, ctypes, 1, "dIn ")
            return ["unknown"] if dev and _ca_get(ca, ctypes, dev, "gone") else []
        held = []
        for obj in procs:
            if not _ca_get(ca, ctypes, obj, "piri"):
                continue
            pid = _ca_get(ca, ctypes, obj, "ppid")
            out = subprocess.run(["ps", "-p", str(pid), "-o", "comm="],
                                 capture_output=True, text=True, timeout=2)
            held.append(out.stdout.strip() or "pid %s" % pid)
        return held
    except Exception as exc:
        log("mic check failed: %s: %s", type(exc).__name__, exc)
        return []


def mic_in_use():
    """The holders of the mic that count: all of them, minus the ignored apps."""
    if os.environ.get("CCRADIO_MIC") == "off":
        return []
    ignore = mic_ignore()
    return [h for h in mic_holders() if not any(i in h.lower() for i in ignore)]


def on_call(s, now=None):
    """True while another app holds the mic, and for MIC_HOLD seconds after.

    The hold keeps a muted second in a call from bringing the music back. It
    runs on the clock, not on a count of checks, so it does not matter how
    often the hooks and the watchdog ask.
    """
    now = time.time() if now is None else now
    held = mic_in_use()
    if held:
        if s.get("mic_busy_at") is None or now - s["mic_busy_at"] > 1.0:
            s["mic_busy_at"] = now
            save_state(s)
        return True
    last = s.get("mic_busy_at")
    return isinstance(last, (int, float)) and 0 <= now - last < MIC_HOLD


FRESH_AFTER = 20.0      # a tab that has not reported for this long is forgotten
AGENTS_STALE = 1800.0   # a subagent count that has not changed in 30 min is noise


# --------------------------------------------------------------------------
# paths
# --------------------------------------------------------------------------

def state_dir():
    d = os.environ.get("CCRADIO_STATE_DIR")
    if not d:
        base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
        d = os.path.join(base, "ccradio")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def sock_path():
    """One socket per state directory, so every process that shares the
    state also shares the player. (A per-environment runtime dir would let
    a shell and a Claude Code tab each talk to a different mpv.)"""
    return os.environ.get("CCRADIO_SOCK") or os.path.join(state_dir(), "ipc.sock")


def state_path():
    return os.path.join(state_dir(), "state.json")


def tabs_path():
    return os.path.join(state_dir(), "tabs.json")


LOG_MAX = 512 * 1024


def log(msg, *args):
    """Trace to a file when CCRADIO_DEBUG is set, otherwise do nothing.

    The mod discards our output, which is right for not disrupting a session
    but leaves a quiet radio impossible to diagnose. This is the way back in.
    """
    if not os.environ.get("CCRADIO_DEBUG"):
        return
    try:
        path = os.path.join(state_dir(), "debug.log")
        if os.path.exists(path) and os.path.getsize(path) > LOG_MAX:
            os.replace(path, path + ".1")
        with open(path, "a") as fh:
            fh.write("%s %-6d %s\n" % (time.strftime("%H:%M:%S"), os.getpid(),
                                       msg % args if args else msg))
    except Exception:
        pass                         # logging must never break the radio


# --------------------------------------------------------------------------
# locking and state
# --------------------------------------------------------------------------

@contextlib.contextmanager
def locked(name="player"):
    """Serialise read-modify-write across processes.

    Two locks. "tabs" guards the tab records and is held for a millisecond,
    so a hook that reports never waits on anything slow. "player" guards
    state.json and mpv, and may be held for seconds while a stream starts.
    Two tabs deciding "nobody is playing, I will start" at the same instant
    is exactly what the player lock prevents. Neither lock is reentrant:
    never nest the same one.
    """
    fh = open(os.path.join(state_dir(), name + ".lock"), "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fh, fcntl.LOCK_UN)
        finally:
            fh.close()


def clean(text, limit=120):
    """Text from a stream or a directory, made safe for a terminal and a prompt.

    A station operator controls the ICY title, and anyone on the path of a
    plain-http stream can rewrite it. Strip control characters, so nothing
    can move the cursor or recolour the band, and keep it short.
    """
    if not isinstance(text, str):
        return ""
    text = re.sub(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?", "", text)   # OSC: titles, links
    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)                # CSI: colours, cursor
    text = re.sub(r"[\x00-\x1f\x7f-\x9f]", "", text)                 # anything else
    return text.strip()[:limit]


def _write_json(path, data):
    tmp = path + ".%d.tmp" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=1)
    os.replace(tmp, path)


# mode - who drives the music:
#   auto    the tabs do: play while any works, pause while none does or you are needed
#   manual  you put this on yourself while nothing was working; the tabs leave it
#   off     you asked for silence; the tabs will not start anything until `auto`
DEFAULT_STATE = {
    "station": None, "order": [], "volume": 70,
    "mode": "auto", "pid": None,
    "wanted_since": None,    # when the tabs first wanted music, for the start delay
    "resume": None,          # the station to come back to after a pause for a question
    "mic_busy_at": None,     # when another app last held the mic, for the call hold
}


def load_state():
    try:
        with open(state_path()) as fh:
            raw = json.load(fh)
        if not isinstance(raw, dict):
            raise ValueError("state is not an object")
        s = dict(DEFAULT_STATE, **raw)
    except Exception:
        s = dict(DEFAULT_STATE)
    if s.get("mode") not in ("auto", "manual", "off"):
        s["mode"] = "auto"
    return s


def save_state(s):
    _write_json(state_path(), s)


# --------------------------------------------------------------------------
# stations
# --------------------------------------------------------------------------

def safe_url(url):
    """Only plain http(s) streams reach mpv. It would open much more."""
    return isinstance(url, str) and url.lower().startswith(("http://", "https://"))


def stations():
    """The station set in play: a genre/language pool if you picked one."""
    pool = read_pool()
    if pool:
        return pool["stations"]
    try:
        with open(CURATED) as fh:
            st = [x for x in json.load(fh)["stations"] if safe_url(x.get("url"))]
        if st:
            return st
    except Exception:
        pass
    return list(FALLBACK)


def find_station(key):
    if not key:
        return None
    st = stations()
    key = str(key).lower()
    for s in st:
        if s["id"].lower() == key:
            return s
    for s in st:
        if key in s["id"].lower() or key in s["name"].lower():
            return s
    return None


def order_ids(s):
    """Current rotation order, repaired if the station set changed underneath."""
    live = [x["id"] for x in stations()]
    order = [i for i in s.get("order") or [] if i in live]
    if not order:
        order = live
    for i in live:
        if i not in order:
            order.append(i)
    return order


def pick_station(s):
    """A station for the automatic music: not the one we just had, if we can help it."""
    pool = [x for x in stations() if x["id"] != s.get("station")] or stations()
    return random.choice(pool)


# --------------------------------------------------------------------------
# mpv IPC
# --------------------------------------------------------------------------

class NotRunning(Exception):
    pass


SOCK_MAX = 100   # Unix socket paths cap near 104 bytes on macOS and 108 on Linux


def ipc(*command, timeout=2.0):
    """Send one command to mpv and return its data field."""
    path = sock_path()
    if not os.path.exists(path):
        raise NotRunning()
    rid = random.randint(1, 2 ** 30)
    payload = json.dumps({"command": list(command), "request_id": rid}) + "\n"
    try:
        sk = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sk.settimeout(timeout)
        sk.connect(path)
        sk.sendall(payload.encode())
        buf = b""
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                chunk = sk.recv(65536)
            except socket.timeout:
                break
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if not line.strip():
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                # mpv interleaves async events; match our request_id.
                if msg.get("request_id") == rid:
                    sk.close()
                    if msg.get("error") not in (None, "success"):
                        raise RuntimeError(msg["error"])
                    return msg.get("data")
        sk.close()
    except (ConnectionRefusedError, FileNotFoundError, OSError) as exc:
        log("ipc %s failed: %s", command[0] if command else "?", exc)
        raise NotRunning()
    log("ipc %s: no reply within %.1fs", command[0] if command else "?", timeout)
    raise NotRunning()


def alive(timeout=2.0):
    try:
        ipc("get_property", "idle-active", timeout=timeout)
        return True
    except Exception:
        return False


def loaded():
    """True when a station is loaded (playing or buffering), False when idle or down."""
    try:
        return not ipc("get_property", "idle-active")
    except Exception:
        return False


# --------------------------------------------------------------------------
# daemon
# --------------------------------------------------------------------------

def mpv_hint():
    return ("brew install mpv" if sys.platform == "darwin"
            else "sudo apt install mpv   # or your package manager")


def find_mpv():
    """mpv's path: CCRADIO_MPV, then PATH, then where package managers put it.

    A Claude Code started from a GUI can have a PATH without Homebrew on it.
    """
    for candidate in (os.environ.get("CCRADIO_MPV"), shutil.which("mpv"),
                      "/opt/homebrew/bin/mpv", "/usr/local/bin/mpv", "/usr/bin/mpv",
                      "/snap/bin/mpv"):
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


def require_mpv():
    if find_mpv():
        return
    log("mpv is not installed")
    die("mpv is not installed. cc-radio needs it.\n  %s" % mpv_hint())


def start_daemon(s=None):
    require_mpv()
    s = s or load_state()
    if alive():
        return s
    path = sock_path()
    if len(path.encode()) > SOCK_MAX:
        log("socket path is %d bytes; the OS allows about %d", len(path), SOCK_MAX)
        die("the socket path is too long for a Unix socket:\n  %s\n"
            "  set CCRADIO_SOCK to a short path, such as /tmp/ccradio.sock" % path)
    # Clear a stale socket left by a crashed daemon.
    if os.path.exists(path):
        try:
            os.unlink(path)
        except OSError:
            pass
    with open(os.devnull, "wb") as devnull:
        proc = subprocess.Popen(
            [find_mpv(), "--idle=yes", "--no-video", "--no-terminal",
             "--ytdl=no",            # a directory URL must never reach yt-dlp
             "--input-ipc-server=" + path,
             "--volume=%d" % s["volume"],
             # Keep the stream alive through flaky wifi rather than dying.
             "--network-timeout=30", "--stream-lavf-o=reconnect_streamed=1",
             "--cache=yes", "--demuxer-max-bytes=8MiB"],
            stdout=devnull, stderr=devnull, stdin=subprocess.DEVNULL,
            start_new_session=True)
    s["pid"] = proc.pid
    for _ in range(50):
        if alive():
            break
        time.sleep(0.1)
    else:
        log("mpv spawned (pid %s) but never answered on %s", proc.pid, path)
        # Do not leave a deaf mpv behind: it would sit there forever.
        try:
            proc.kill()
            proc.wait(timeout=2)
        except Exception:
            pass
        s["pid"] = None
        save_state(s)
        die("mpv did not come up. Try: mpv --version")
    log("daemon up, pid %s, volume %s", proc.pid, s["volume"])
    save_state(s)
    start_watchdog()
    return s


def start_watchdog():
    """A detached process that reconciles every few seconds while mpv lives.

    The tabs drive the player, but a tab that dies without a word drives
    nothing. With one tab open and gone, nobody would ever stop the music.
    The watchdog is that somebody: it exits when the daemon does.
    """
    if os.environ.get("CCRADIO_NO_WATCHDOG"):
        return
    try:
        with open(os.devnull, "wb") as devnull:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "watchdog"],
                             stdout=devnull, stderr=devnull, stdin=subprocess.DEVNULL,
                             start_new_session=True)
    except Exception as exc:
        log("watchdog: could not start: %s", exc)


WATCHDOG_EVERY = 3.0       # also how soon a call is noticed


def cmd_watchdog(_):
    """Reconcile every WATCHDOG_EVERY seconds until the daemon is gone. One at a time."""
    fh = open(os.path.join(state_dir(), "watchdog.lock"), "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return                           # another watchdog is on duty
    log("watchdog up")
    try:
        while True:
            time.sleep(WATCHDOG_EVERY)
            if not alive():
                log("watchdog: daemon gone, standing down")
                return
            try:
                _reconcile_once()
            except SystemExit:
                pass
            except Exception as exc:
                log("watchdog: %s: %s", type(exc).__name__, exc)
    finally:
        fh.close()


def pid_is_our_mpv(pid):
    """Only ever signal a process that is still our mpv. Pids get reused."""
    try:
        out = subprocess.run(["ps", "-o", "command=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return False
    return "mpv" in out and sock_path() in out


def stop_daemon(s=None):
    s = s or load_state()
    try:
        ipc("quit")
    except Exception:
        pass
    pid = s.get("pid")
    if pid and pid_is_our_mpv(pid):
        try:
            os.kill(pid, 15)
        except OSError:
            pass
    s["pid"] = None
    save_state(s)
    try:
        os.unlink(sock_path())
    except OSError:
        pass
    return s


# --------------------------------------------------------------------------
# playback
# --------------------------------------------------------------------------

def resolve_pls(url):
    """SomaFM and friends hand out .pls playlists; mpv wants the stream."""
    if not url.lower().endswith((".pls", ".m3u", ".m3u8")):
        return url
    if url.lower().endswith(".m3u8"):
        return url  # HLS - mpv plays this directly
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        txt = urllib.request.urlopen(req, timeout=10).read().decode("utf-8", "replace")
    except Exception:
        return url
    for line in txt.splitlines():
        low = line.strip().lower()
        if low.startswith("file1="):
            found = line.split("=", 1)[1].strip()
            return found if safe_url(found) else url
        if low.startswith("http"):
            return line.strip()
    return url


def play(station, s=None):
    """Load a station. Does not touch the mode - the caller decides ownership."""
    if not station or not safe_url(station.get("url")):
        die("that station has no playable http(s) stream")
    s = start_daemon(s or load_state())
    url = resolve_pls(station["url"])
    log("play %s -> %s", station["id"], url)
    ipc("loadfile", url, "replace")
    ipc("set_property", "pause", False)
    s["station"] = station["id"]
    save_state(s)
    return s


def unload(s=None):
    """Silence without killing the daemon.

    A live stream cannot really pause: mpv keeps filling its buffer and then
    stalls, and a resume plays stale audio. Unloading and reloading is always
    live and costs about a second.
    """
    s = s or load_state()
    try:
        ipc("stop")
    except Exception:
        pass
    return s


def step(delta):
    s = load_state()
    order = order_ids(s)
    cur = s.get("station")
    idx = order.index(cur) if cur in order else -1
    nxt = order[(idx + delta) % len(order)]
    st = find_station(nxt) or stations()[0]
    play(st, s)
    return st


def now_playing(timeout=2.0):
    """Current track from ICY metadata, or None if it has not arrived yet.

    Right after a station switch mpv falls back to the URL basename for
    media-title, which is not a track name - suppress that.
    """
    try:
        path = ipc("get_property", "path", timeout=timeout) or ""
    except Exception:
        path = ""
    placeholder = path.rstrip("/").rsplit("/", 1)[-1].lower()
    for prop in ("metadata/by-key/icy-title", "media-title"):
        try:
            v = ipc("get_property", prop, timeout=timeout)
        except Exception:
            continue
        if not v or not isinstance(v, str):
            continue
        v = clean(v)
        if not v or v.startswith("http") or v.lower() == placeholder:
            continue
        return v
    return None


def set_volume(vol, s=None):
    s = s or load_state()
    vol = max(0, min(VOL_MAX, int(vol)))
    try:
        ipc("set_property", "volume", vol)
    except NotRunning:
        pass
    s["volume"] = vol
    save_state(s)
    return vol


# --------------------------------------------------------------------------
# the working signal
# --------------------------------------------------------------------------

def read_tabs():
    """Every tab's latest record, minus the ones that stopped reporting."""
    try:
        with open(tabs_path()) as fh:
            raw = json.load(fh)
        if not isinstance(raw, dict):
            return {}
    except Exception:
        return {}
    now = time.time()
    out = {}
    for sid, rec in raw.items():
        if not isinstance(rec, dict):
            continue
        at = rec.get("at")
        if not isinstance(at, (int, float)) or now - at >= FRESH_AFTER:
            continue
        out[sid] = rec
    return out


def write_tabs(tabs):
    _write_json(tabs_path(), tabs)


def tab_is_working(rec, now):
    """One tab's answer: is Claude doing something here that nobody is waiting on?"""
    if rec.get("waiting"):
        return False
    if rec.get("turn"):
        return True
    agents = rec.get("agents") or 0
    agents_at = rec.get("agents_at")
    if agents and isinstance(agents_at, (int, float)) and now - agents_at < AGENTS_STALE:
        return True                   # a background subagent is still at it
    return False


def decide(tabs, now=None, call=False):
    """The one rule, from every tab's record.

    Returns (wanted, code, why). Play when any tab is working and no tab is
    waiting on you. You win over the machine: a question in one tab pauses
    the music even while another tab works, because you are about to think.
    The same goes for a call: while another app holds the mic, no music.
    Codes: working, waiting, call, idle, none.
    """
    now = time.time() if now is None else now
    if not tabs:
        return False, "none", "no tab is open"
    if any(rec.get("waiting") for rec in tabs.values()):
        return False, "waiting", "a tab is waiting on you"
    working = [sid for sid, rec in tabs.items() if tab_is_working(rec, now)]
    if working and call:
        return False, "call", "another app is using the mic"
    if working:
        return True, "working", "%d tab(s) working" % len(working)
    return False, "idle", "every tab is idle"


def reconcile(fork=False):
    """Make the player match what the tabs want. Safe to call any time, from anywhere.

    With fork=True the work happens in a detached child, so a hook returns at
    once; the child also waits out the start delay instead of giving up on it.
    """
    if fork:
        if os.fork() != 0:
            return                   # the parent returns to the hook at once
        os.setsid()
        # Let go of the caller's pipes, or $.process.run waits for us to exit.
        try:
            null = os.open(os.devnull, os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(null, fd)
        except OSError:
            pass
        try:
            reconcile(fork=False)
        except SystemExit:
            pass
        except Exception as exc:
            log("reconcile: %s: %s", type(exc).__name__, exc)
        finally:
            os._exit(0)

    for _ in range(3):               # at most: once now, once after the delay, once more
        wait = _reconcile_once()
        if wait is None:
            return
        time.sleep(wait)


def _reconcile_once():
    """One pass under the lock. Returns seconds to wait and retry, or None when settled."""
    with locked():
        s = load_state()
        tabs = read_tabs()
        wanted, code, why = decide(tabs, call=on_call(s))
        if s["mode"] != "auto":
            log("reconcile: mode is %s, leaving the player alone (%s)", s["mode"], why)
            if not tabs and s["mode"] == "off" and alive():
                # Every tab is gone: no reason to keep a silent daemon around.
                stop_daemon(s)
            return None
        playing = loaded()
        if not wanted:
            # A pause for a question keeps its place in the start delay, so the
            # music comes straight back once you have answered. Going idle
            # resets it, so the next quick answer stays silent.
            changed = False
            if code not in ("waiting", "call") and (
                    s.get("wanted_since") is not None or s.get("resume")):
                s["wanted_since"], s["resume"] = None, None
                changed = True
            if not tabs and alive():
                log("reconcile: no tabs left, daemon down")
                stop_daemon(s)
            elif playing:
                log("reconcile: pause (%s)", why)
                if code in ("waiting", "call"):
                    s["resume"] = s.get("station")   # come back to the same station
                    changed = True
                unload(s)
            else:
                log("reconcile: silent already (%s)", why)
            if changed:
                save_state(s)
            return None
        # Music is wanted. Has it been wanted for long enough?
        now = time.time()
        since = s.get("wanted_since")
        if not isinstance(since, (int, float)) or since > now:
            since = now
            s["wanted_since"] = since
            save_state(s)
        remaining = start_delay() - (now - since)
        if remaining > 0:
            log("reconcile: wanted (%s), %.1fs of delay left", why, remaining)
            return remaining + 0.05
        if playing:
            log("reconcile: playing already (%s)", why)
            return None
        st = find_station(s.get("resume")) or pick_station(s)
        s["resume"] = None
        log("reconcile: play %s (%s)", st["id"], why)
        try:
            play(st, s)
        except SystemExit:
            log("reconcile: could not start the player")
        return None


def report(sid, fields, gone=False):
    """Record one tab's state, then reconcile. The mod calls this on every change."""
    with locked("tabs"):
        try:
            with open(tabs_path()) as fh:
                tabs = json.load(fh)
            if not isinstance(tabs, dict):
                tabs = {}
        except Exception:
            tabs = {}
        now = time.time()
        # Drop records nobody refreshes, so the file cannot grow forever.
        tabs = {k: v for k, v in tabs.items()
                if isinstance(v, dict) and isinstance(v.get("at"), (int, float))
                and now - v["at"] < FRESH_AFTER}
        if gone:
            tabs.pop(sid, None)
        else:
            prev = tabs.get(sid) or {}
            rec = dict(prev)
            rec.update(fields)
            rec["at"] = now
            # The clock on a subagent count starts when the count changes, not
            # on every heartbeat, or a leaked agent would count forever.
            if "agents" in fields and fields["agents"] != prev.get("agents"):
                rec["agents_at"] = now
            tabs[sid] = rec
        write_tabs(tabs)
    log("report %s %s", sid[:8], "gone" if gone else json.dumps(fields, sort_keys=True))


# --------------------------------------------------------------------------
# output
# --------------------------------------------------------------------------

def die(msg):
    sys.stderr.write("ccradio: %s\n" % msg)
    sys.exit(1)


def say(msg):
    sys.stdout.write(msg + "\n")


def describe(s=None):
    s = s or load_state()
    st = find_station(s.get("station"))
    mode = s["mode"]
    if not alive():
        if not find_mpv():
            return "mpv is not installed - no audio. Install it with: %s" % mpv_hint()
        return "stopped" + ("" if mode == "auto" else "  |  %s" % mode)
    bits = []
    if loaded():
        try:
            paused = ipc("get_property", "pause")
        except Exception:
            paused = False
        bits.append("paused" if paused else "playing")
        if st:
            bits.append(st["name"])
        track = now_playing()
        if track:
            bits.append(track)
    else:
        bits.append("silent")
    try:
        vol = int(ipc("get_property", "volume"))
    except Exception:
        vol = s["volume"]
    bits.append("vol %d" % vol)
    if mode != "auto":
        bits.append(mode)
    return "  |  ".join(bits)


# --------------------------------------------------------------------------
# search
# --------------------------------------------------------------------------

_RB_SERVER = None


def rb_server():
    """One of Radio Browser's mirrors, looked up once per process."""
    global _RB_SERVER
    if _RB_SERVER:
        return _RB_SERVER
    try:
        req = urllib.request.Request(
            "https://all.api.radio-browser.info/json/servers",
            headers={"User-Agent": UA})
        servers = json.loads(urllib.request.urlopen(req, timeout=5).read())
        names = sorted({s["name"] for s in servers if s.get("name")})
        if names:
            _RB_SERVER = random.choice(names)
    except Exception:
        pass
    _RB_SERVER = _RB_SERVER or "de1.api.radio-browser.info"
    return _RB_SERVER


class DirectoryDown(Exception):
    pass


def rb_query(params):
    q = urllib.parse.urlencode(dict(params, hidebroken="true", order="clickcount",
                                    reverse="true"))
    url = "https://%s/json/stations/search?%s" % (rb_server(), q)
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        recs = json.loads(urllib.request.urlopen(req, timeout=8).read())
    except Exception as exc:
        log("radio browser: %s", exc)
        raise DirectoryDown()
    return [r for r in recs if isinstance(r, dict)
            and safe_url(r.get("url_resolved") or r.get("url"))]


def search(term, limit=20):
    """Stations whose name or tags match. Radio Browser's name search alone
    misses a genre typed as a search term, so ask twice and merge."""
    seen, out = set(), []
    for field in ("name", "tag"):
        recs = rb_query({field: term, "limit": limit})
        for r in recs:
            key = r.get("stationuuid") or r.get("url")
            if key in seen:
                continue
            seen.add(key)
            out.append(r)
    return out[:limit]


def save_found(results):
    """Stash search hits so `ccradio play <n>` can reach them."""
    _write_json(os.path.join(state_dir(), "found.json"), results)


def load_found():
    try:
        with open(os.path.join(state_dir(), "found.json")) as fh:
            found = json.load(fh)
        return found if isinstance(found, list) else []
    except Exception:
        return []


# --------------------------------------------------------------------------
# genre and language pools
# --------------------------------------------------------------------------

# Radio Browser tags worth suggesting. Not a whitelist - any tag it knows works.
GENRE_PRESETS = (
    "lofi", "jazz", "classical", "ambient", "electronic", "rock", "metal",
    "hip hop", "blues", "funk", "soul", "reggae", "folk", "techno", "piano",
    "bollywood", "carnatic", "ghazal",
)


def pool_path():
    return os.path.join(state_dir(), "pool.json")


def read_pool():
    """The genre or language pool you picked, or None for the built-ins."""
    try:
        with open(pool_path()) as fh:
            pool = json.load(fh)
        sts = [x for x in pool.get("stations") or [] if safe_url(x.get("url"))]
        if sts:
            pool["stations"] = sts
            return pool
    except Exception:
        pass
    return None


def write_pool(label, sts):
    _write_json(pool_path(), {"label": label, "stations": sts})


def drop_pool():
    try:
        os.unlink(pool_path())
    except OSError:
        pass


def pool_id(name, taken):
    """A readable id for a fetched station, unique within its own pool."""
    base = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:20] or "station"
    out, n = base, 2
    while out in taken:
        out, n = "%s-%d" % (base, n), n + 1
    taken.add(out)
    return out


def as_station(rec, taken):
    """Reshape a Radio Browser record into what stations() hands out."""
    name = clean(rec.get("name"), 60) or "unnamed"
    return {
        "id": pool_id(name, taken),
        "name": name,
        "genre": clean(rec.get("tags"), 44).replace(",", ", "),
        "url": rec.get("url_resolved") or rec.get("url"),
        "source": "Radio Browser",
        "homepage": rec.get("homepage") or "",
    }


def rb_fetch(field, term, limit=30):
    """Stations matching one Radio Browser field - 'tag' or 'language'."""
    taken, out = set(), []
    for rec in rb_query({field: term, "limit": limit}):
        out.append(as_station(rec, taken))
    return out


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def _set_mode(s, mode):
    s["mode"] = mode
    s["wanted_since"] = None
    save_state(s)


def cmd_play(args):
    """Play now. While nothing is working, that makes the music yours."""
    s = load_state()
    if args:
        key = " ".join(args)
        if key.isdigit():
            found = load_found()
            i = int(key) - 1
            if not (0 <= i < len(found)):
                die("no search result %s - run: ccradio search <term>" % key)
            r = found[i]
            st = {"id": "rb-" + str(r.get("stationuuid", ""))[:8],
                  "name": clean(r.get("name"), 60) or "unnamed",
                  "genre": clean(r.get("tags"), 44),
                  "url": r.get("url_resolved") or r.get("url"),
                  "source": "Radio Browser"}
        else:
            st = find_station(key)
            if not st:
                die("no station matching '%s' - try: ccradio stations" % key)
    else:
        st = find_station(s.get("station")) or stations()[0]
    wanted, _, _ = decide(read_tabs())
    if s["mode"] == "off" or not wanted:
        # Nothing is working, or you had switched us off: this music is yours.
        s["mode"] = "manual"
        s["wanted_since"] = None
    play(st, s)
    say("> %s  (%s)%s" % (st["name"], st.get("genre") or st.get("source", ""),
                           "  [yours - ccradio auto hands it back]"
                           if s["mode"] == "manual" else ""))


def cmd_next(_):
    st = step(1)
    say("> %s  (%s)" % (st["name"], st.get("genre", "")))


def cmd_prev(_):
    st = step(-1)
    say("> %s  (%s)" % (st["name"], st.get("genre", "")))


def cmd_shuffle(_):
    s = load_state()
    order = order_ids(s)
    random.shuffle(order)
    s["order"] = order
    save_state(s)
    say("~ shuffled %d stations" % len(order))
    if loaded():
        st = find_station(order[0]) or stations()[0]
        play(st, s)
        say("> %s  (%s)" % (st["name"], st.get("genre", "")))


def cmd_auto(_):
    """Hand the radio back to the tabs. If one is working, music comes back now."""
    with locked():
        s = load_state()
        s["mode"] = "auto"
        s["wanted_since"] = time.time() - start_delay()   # you asked: no delay
        save_state(s)
    reconcile(fork=not os.environ.get("CCRADIO_SYNC"))
    wanted, _, why = decide(read_tabs())
    say("auto: %s" % ("music is on its way (%s)" % why if wanted else "silent (%s)" % why))


def cmd_off(_):
    """Silence, and the tabs will not start anything until `ccradio auto`."""
    s = load_state()
    _set_mode(s, "off")
    unload(s)
    say("off - silence until: ccradio auto")


def cmd_stop(_):
    """Off, and the daemon down too."""
    s = load_state()
    _set_mode(s, "off")
    stop_daemon(s)
    say("stopped - the tabs stay quiet until: ccradio auto")


def cmd_vol(args):
    s = load_state()
    if not args:
        say("vol %d" % s["volume"])
        return
    a = args[0].lower()
    if a in ("up", "+"):
        v = set_volume(s["volume"] + VOL_STEP, s)
    elif a in ("down", "-"):
        v = set_volume(s["volume"] - VOL_STEP, s)
    elif a.lstrip("-").isdigit():
        v = set_volume(int(a), s)
    else:
        die("usage: ccradio vol [up|down|<0-%d>]" % VOL_MAX)
    say("vol %d" % v)


def cmd_now(_):
    if not loaded():
        die("nothing is playing - run: ccradio play")
    track = now_playing()
    st = find_station(load_state().get("station"))
    say("%s%s" % (track or "(no track metadata)",
                  "  --  %s" % st["name"] if st else ""))


def cmd_status(_):
    say(describe())


def cmd_statusline(args):
    """One compact segment for the Claude Code statusline.

    Prints nothing when the radio is silent, so the statusline stays clean.
    Must never fail or hang - the statusline runs on every render - so every
    IPC call here has a short timeout.
    """
    width = 46
    for a in args:
        if a.startswith("--width="):
            try:
                width = max(12, int(a.split("=", 1)[1]))
            except ValueError:
                pass
    try:
        if not alive(timeout=0.4):
            return
        if ipc("get_property", "idle-active", timeout=0.4):
            return
        paused = bool(ipc("get_property", "pause", timeout=0.4))
        st = find_station(load_state().get("station"))
        name = st["name"] if st else "radio"
        track = None if paused else now_playing(timeout=0.4)
        seg = ("%s %s" % ("||" if paused else "♪", name))
        if track:
            seg += " · " + track
        if len(seg) > width:
            seg = seg[:width - 1].rstrip() + "…"
        say(seg)
    except Exception:
        return


def cmd_stations(_):
    s = load_state()
    cur = s.get("station")
    pool = read_pool()
    if pool:
        kind = pool["label"].split(":", 1)[0]
        say("%s - ccradio %s off for the built-ins\n" % (pool["label"], kind))
    for st in stations():
        mark = "*" if st["id"] == cur else " "
        # Clipped: a fetched pool carries names far longer than the built-ins.
        say("%s %-22.22s %-26.26s %.34s" % (
            mark, st["id"], st["name"], st.get("genre", "")))


def cmd_search(args):
    if not args:
        die("usage: ccradio search <term>")
    try:
        res = search(" ".join(args))
    except DirectoryDown:
        die("Radio Browser is unreachable right now - the built-in stations still work")
    if not res:
        say("no stations found")
        return
    save_found(res)
    for i, r in enumerate(res, 1):
        say("%2d. %-34s %-8s %-6s %s" % (
            i, clean(r.get("name"), 34), clean(r.get("countrycode"), 8),
            "%skbps" % r.get("bitrate", "?"), clean(r.get("tags"), 36)))
    say("\nplay one with: ccradio play <number>")


OFF_WORDS = ("off", "clear", "none", "reset", "default", "built-in", "builtin")


def set_pool(field, word, args):
    """Shared body of `ccradio genre` and `ccradio language`."""
    term = " ".join(args).strip()
    if not term:
        pool = read_pool()
        say("now playing from: %s" % (pool["label"] if pool else
                                      "the built-in stations"))
        if word == "genre":
            say("\ntry one of: %s" % ", ".join(GENRE_PRESETS))
            say("or any tag Radio Browser knows.")
        else:
            say("\nany language Radio Browser knows: tamil, hindi, malayalam,"
                " telugu, french, japanese ...")
        say("\n  ccradio %s <name>   switch to it" % word)
        say("  ccradio %s off      back to the built-ins" % word)
        return
    if term.lower() in OFF_WORDS:
        drop_pool()
        s = load_state()
        s["order"] = []
        save_state(s)
        say("back to the built-in stations")
        return
    try:
        sts = rb_fetch(field, term)
    except DirectoryDown:
        die("Radio Browser is unreachable right now - the built-in stations still work")
    if not sts:
        die("nothing found for %s '%s'. See: ccradio %s" % (word, term, word))
    with locked():                      # the fetch ran outside; the switch runs inside
        write_pool("%s: %s" % (word, term), sts)
        s = load_state()
        s["order"] = []
        save_state(s)
        say("%s: %s  (%d stations)" % (word, term, len(sts)))
        # Switch the music over if there is any, but do not start any: the pool
        # is a preference, and the tabs decide when it plays.
        if loaded() or s["mode"] == "manual":
            play(random.choice(sts), s)


def cmd_genre(args):
    """Pick a genre, and keep the automatic music inside it."""
    set_pool("tag", "genre", args)


def cmd_language(args):
    """Pick a language, and keep the automatic music inside it."""
    set_pool("language", "language", args)


def cmd_debug(args):
    """Show the trace log, or explain how to turn it on."""
    path = os.path.join(state_dir(), "debug.log")
    if args and args[0] in ("clear", "reset"):
        for f in (path, path + ".1"):
            try:
                os.unlink(f)
            except OSError:
                pass
        say("log cleared")
        return
    if not os.environ.get("CCRADIO_DEBUG") and not os.path.exists(path):
        say("Tracing is off, so nothing has been recorded.\n")
        say("Turn it on in ~/.claude/settings.json and restart Claude Code:\n")
        say('  "env": { "CCRADIO_DEBUG": "1" }\n')
        say("  ccradio debug          read the trace")
        say("  ccradio debug clear    start it over")
        return
    if not os.path.exists(path):
        say("Tracing is on, but nothing is recorded yet. Send a prompt first.")
        return
    n = 40
    if args and args[0].lstrip("-").isdigit():
        n = abs(int(args[0]))
    with open(path) as fh:
        lines = fh.read().splitlines()
    for line in lines[-n:]:
        say(line)
    if not os.environ.get("CCRADIO_DEBUG"):
        say("\n(tracing is off now - this is an older log)")


def cmd_start(_):
    start_daemon()
    say("daemon up")


def cmd_mic(_):
    """Who holds the mic right now, and whether it counts (debugging)."""
    held = mic_holders()
    if not held:
        say("the mic is free")
        return
    ignore = mic_ignore()
    for h in held:
        skipped = any(i in h.lower() for i in ignore)
        say("%s%s" % (h, "   (ignored)" if skipped else ""))


def cmd_working(_):
    """Which tabs are reporting, and what each one says (debugging)."""
    tabs = read_tabs()
    if not tabs:
        say("no tab is reporting")
        return
    now = time.time()
    wanted, _, why = decide(tabs, now, call=on_call(load_state(), now))
    for sid, rec in sorted(tabs.items(), key=lambda kv: kv[1].get("at", 0)):
        flags = []
        if rec.get("turn"):
            flags.append("turn")
        if rec.get("waiting"):
            flags.append("waiting on you")
        if rec.get("agents"):
            flags.append("%d agent(s)" % rec["agents"])
        say("%-40s %-28s %.0fs ago" % (sid[:40], ", ".join(flags) or "idle",
                                       now - rec.get("at", now)))
    say("\n-> %s: %s" % ("play" if wanted else "silence", why))


def _parse_report(args):
    """`report <sid> [turn=0|1] [waiting=0|1] [agents=N] [gone]`"""
    if not args:
        die("usage: ccradio report <session_id> [turn=0|1] [waiting=0|1] [agents=N] [gone]")
    sid = args[0]
    fields, gone = {}, False
    for a in args[1:]:
        if a == "gone":
            gone = True
            continue
        if "=" not in a:
            die("report: expected key=value, got %r" % a)
        k, v = a.split("=", 1)
        if k in ("turn", "waiting"):
            fields[k] = v.strip().lower() in ("1", "true", "yes")
        elif k == "agents":
            try:
                fields[k] = max(0, int(v))
            except ValueError:
                die("report: agents must be a number")
        else:
            die("report: unknown field %r" % k)
    return sid, fields, gone


def cmd_report(args):
    """The mod's one verb: here is what this tab looks like now."""
    sid, fields, gone = _parse_report(args)
    report(sid, fields, gone)
    # The hook wants to return at once; the decision can take a few seconds
    # (daemon start, start delay). Tests set CCRADIO_SYNC to keep it inline.
    reconcile(fork=not os.environ.get("CCRADIO_SYNC"))
    # Hand the mod a band line in the same breath, so it costs no extra process.
    # The forked reconcile may still be at work, so only claim music the tabs want.
    wanted, _, _ = decide(read_tabs())
    mode = load_state()["mode"]
    if wanted and mode == "auto" and not find_mpv():
        say("cc-radio: install mpv to hear the radio (%s)" % mpv_hint().split("   #")[0])
        return
    if mode == "manual" or (wanted and mode == "auto"):
        cmd_statusline([])


def cmd_reconcile(_):
    """Make the player match the tabs, right now, inline."""
    reconcile()
    say(describe())


COMMANDS = {
    "play": cmd_play, "next": cmd_next, "prev": cmd_prev, "previous": cmd_prev,
    "shuffle": cmd_shuffle,
    "auto": cmd_auto, "resume": cmd_auto,
    "off": cmd_off, "pause": cmd_off,
    "stop": cmd_stop,
    "vol": cmd_vol, "volume": cmd_vol, "now": cmd_now, "status": cmd_status,
    "stations": cmd_stations, "list": cmd_stations, "search": cmd_search,
    "genre": cmd_genre, "language": cmd_language, "lang": cmd_language,
    "statusline": cmd_statusline, "debug": cmd_debug,
    "start": cmd_start, "working": cmd_working, "mic": cmd_mic,
    "report": cmd_report, "reconcile": cmd_reconcile, "watchdog": cmd_watchdog,
}

# Commands that read, change, and act on the player state: one at a time, and
# never while a reconciler is mid-start. The rest lock what they need inside.
LOCKED = {"play", "next", "prev", "previous", "shuffle", "off", "pause", "stop",
          "vol", "volume", "start"}

USAGE = """ccradio - internet radio while Claude works

  status             what's playing right now (also: ccradio with no arguments)
  play [station|N]   play now, or switch station (N = a search result)
  next / prev        move one station along
  shuffle            reshuffle the station order
  pause / off        silence, and the tabs stay quiet until `auto`
  auto / resume      hand the radio back to the tabs
  stop               off, and the player process down too
  vol up|down|<n>    volume, 0-130 (mpv only, never system volume)
  now                current track
  stations           list the stations in play
  genre [name|off]   pick a genre, and keep the automatic music in it
  language [name]    same, by language
  search <term>      find more via Radio Browser
  working            which tabs are reporting, and what the radio decided
  mic                which app holds the mic (a call pauses the music)
  debug [n|clear]    trace log - why the radio did or didn't do something
  statusline         compact segment for the Claude Code statusline
  report / reconcile / watchdog   what the mod and the player call; you never need to
"""


def main(argv):
    if not argv:
        return main(["status"])
    if argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    cmd = argv[0].lower()
    fn = COMMANDS.get(cmd)
    if not fn:
        die("unknown command '%s'. Try: ccradio help" % cmd)
    try:
        if cmd in LOCKED:
            with locked():
                fn(argv[1:])
        else:
            fn(argv[1:])
    except NotRunning:
        die("the player is not running - run: ccradio play")
    except SystemExit:
        raise
    except Exception as exc:
        log("%s: %s: %s", cmd, type(exc).__name__, exc)
        die("%s failed: %s: %s" % (cmd, type(exc).__name__, exc))
    return 0


if __name__ == "__main__":
    os.umask(0o077)                      # state files and the socket are ours alone
    sys.exit(main(sys.argv[1:]))
