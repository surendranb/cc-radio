#!/usr/bin/env python3
"""ccradio - internet radio for your terminal, driven by a detached mpv daemon.

All state lives outside the calling process, so playback survives between
Claude Code turns and across sessions.
"""

import contextlib
import fcntl
import json
import os
import random
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request

UA = "cc-radio/0.4 (+https://github.com/surendranb/cc-radio)"
VOL_STEP = 10
VOL_MAX = 130
DUCK_FLOOR = 10
DUCK_RATIO = 0.25

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CURATED = os.path.join(HERE, "stations", "curated.json")

# Hardcoded last resort if curated.json is missing or corrupt.
FALLBACK = [
    {"id": "soma-groovesalad", "name": "Groove Salad", "genre": "ambient, electronic",
     "url": "https://ice2.somafm.com/groovesalad-256-mp3", "source": "SomaFM"},
    {"id": "soma-dronezone", "name": "Drone Zone", "genre": "ambient",
     "url": "https://ice2.somafm.com/dronezone-256-mp3", "source": "SomaFM"},
    {"id": "rp-main", "name": "Radio Paradise - Main Mix", "genre": "eclectic rock",
     "url": "https://stream.radioparadise.com/mp3-192", "source": "Radio Paradise"},
]


# --------------------------------------------------------------------------
# paths
# --------------------------------------------------------------------------

def state_dir():
    d = os.environ.get("CCRADIO_STATE_DIR") or os.path.expanduser(
        "~/.local/state/ccradio")
    os.makedirs(d, exist_ok=True)
    return d


def sock_path():
    if os.environ.get("CCRADIO_SOCK"):
        return os.environ["CCRADIO_SOCK"]
    run = os.environ.get("XDG_RUNTIME_DIR")
    if run and os.path.isdir(run):
        return os.path.join(run, "ccradio.sock")
    return os.path.join(state_dir(), "ipc.sock")


def state_path():
    return os.path.join(state_dir(), "state.json")


LOG_MAX = 512 * 1024


def log(msg, *args):
    """Trace to a file when CCRADIO_DEBUG is set, otherwise do nothing.

    Hooks run detached with their output sent to /dev/null, which is right for
    not disrupting a session but leaves a quiet radio impossible to diagnose.
    This is the way back in.
    """
    if not os.environ.get("CCRADIO_DEBUG"):
        return
    try:
        path = os.path.join(state_dir(), "debug.log")
        if os.path.exists(path) and os.path.getsize(path) > LOG_MAX:
            os.replace(path, path + ".1")
        with open(path, "a") as fh:
            fh.write("%s %-6d %s\n" % (time.strftime("%H:%M:%S"), os.getpid(),
                                       msg % args if args else msg))
    except Exception:
        pass                         # logging must never break the radio


# --------------------------------------------------------------------------
# state (atomic writes - several sessions may write at once)
# --------------------------------------------------------------------------

DEFAULT_STATE = {
    "station": None, "order": [], "volume": 70, "shuffle": False,
    "ducked": False, "preduck": None, "pid": None,
    # manual - you started this yourself, so the hooks must not stop it
    "manual": False,
}


def load_state():
    try:
        with open(state_path()) as fh:
            s = dict(DEFAULT_STATE, **json.load(fh))
    except Exception:
        s = dict(DEFAULT_STATE)
    return s


def save_state(s):
    tmp = state_path() + ".%d.tmp" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump(s, fh, indent=1)
    os.replace(tmp, state_path())


# --------------------------------------------------------------------------
# stations
# --------------------------------------------------------------------------

def stations():
    """The station set in play: a genre/language pool if you picked one.

    Everything reads its stations through here, so a pool covers the automatic
    music too and not just a hand-played station.
    """
    pool = read_pool()
    if pool:
        return pool["stations"]
    try:
        with open(CURATED) as fh:
            st = json.load(fh)["stations"]
        if st:
            return st
    except Exception:
        pass
    return list(FALLBACK)


def find_station(key):
    st = stations()
    key = key.lower()
    for s in st:
        if s["id"].lower() == key:
            return s
    for s in st:
        if key in s["id"].lower() or key in s["name"].lower():
            return s
    return None


def order_ids(s):
    """Current rotation order, repaired if curated.json changed underneath us."""
    live = [x["id"] for x in stations()]
    order = [i for i in s.get("order") or [] if i in live]
    if not order:
        order = live
    for i in live:
        if i not in order:
            order.append(i)
    return order


# --------------------------------------------------------------------------
# mpv IPC
# --------------------------------------------------------------------------

class NotRunning(Exception):
    pass


def ipc(*command, timeout=2.0):
    """Send one command to mpv and return its data field."""
    path = sock_path()
    if not os.path.exists(path):
        raise NotRunning()
    rid = random.randint(1, 2 ** 30)
    payload = json.dumps({"command": list(command), "request_id": rid}) + "\n"
    try:
        sk = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sk.settimeout(timeout)
        sk.connect(path)
        sk.sendall(payload.encode())
        buf = b""
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                chunk = sk.recv(65536)
            except socket.timeout:
                break
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if not line.strip():
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                # mpv interleaves async events; match our request_id.
                if msg.get("request_id") == rid:
                    sk.close()
                    if msg.get("error") not in (None, "success"):
                        raise RuntimeError(msg["error"])
                    return msg.get("data")
        sk.close()
    except (ConnectionRefusedError, FileNotFoundError, OSError) as exc:
        log("ipc %s failed: %s", command[0] if command else "?", exc)
        raise NotRunning()
    log("ipc %s: no reply within %.1fs", command[0] if command else "?", timeout)
    raise NotRunning()


def alive():
    try:
        ipc("get_property", "idle-active")
        return True
    except Exception:
        return False


# --------------------------------------------------------------------------
# daemon
# --------------------------------------------------------------------------

def require_mpv():
    if shutil.which("mpv"):
        return
    hint = ("brew install mpv" if sys.platform == "darwin"
            else "sudo apt install mpv   # or your package manager")
    die("mpv is not installed. cc-radio needs it.\n  %s" % hint)


def start_daemon(s=None):
    require_mpv()
    s = s or load_state()
    if alive():
        return s
    path = sock_path()
    # Clear a stale socket left by a crashed daemon.
    if os.path.exists(path):
        try:
            os.unlink(path)
        except OSError:
            pass
    devnull = open(os.devnull, "wb")
    proc = subprocess.Popen(
        ["mpv", "--idle=yes", "--no-video", "--no-terminal",
         "--input-ipc-server=" + path,
         "--volume=%d" % s["volume"],
         # Keep the stream alive through flaky wifi rather than dying.
         "--network-timeout=30", "--stream-lavf-o=reconnect_streamed=1",
         "--cache=yes", "--demuxer-max-bytes=8MiB"],
        stdout=devnull, stderr=devnull, stdin=subprocess.DEVNULL,
        start_new_session=True)
    s["pid"] = proc.pid
    for _ in range(50):
        if alive():
            break
        time.sleep(0.1)
    else:
        log("mpv spawned (pid %s) but never answered on %s", proc.pid, path)
        die("mpv did not come up. Try: mpv --version")
    log("daemon up, pid %s, volume %s", proc.pid, s["volume"])
    save_state(s)
    return s


def stop_daemon():
    s = load_state()
    try:
        ipc("quit")
    except Exception:
        pass
    pid = s.get("pid")
    if pid:
        try:
            os.kill(pid, 15)
        except OSError:
            pass
    s["pid"] = None
    s["ducked"] = False
    s["preduck"] = None
    save_state(s)
    try:
        os.unlink(sock_path())
    except OSError:
        pass


# --------------------------------------------------------------------------
# playback
# --------------------------------------------------------------------------

def resolve_pls(url):
    """SomaFM and friends hand out .pls playlists; mpv wants the stream."""
    if not url.lower().endswith((".pls", ".m3u", ".m3u8")):
        return url
    if url.lower().endswith(".m3u8"):
        return url  # HLS - mpv plays this directly
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        txt = urllib.request.urlopen(req, timeout=10).read().decode("utf-8", "replace")
    except Exception:
        return url
    for line in txt.splitlines():
        low = line.strip().lower()
        if low.startswith("file1="):
            return line.split("=", 1)[1].strip()
        if line.strip().startswith("http"):
            return line.strip()
    return url


def play(station, s=None):
    s = start_daemon(s or load_state())
    url = resolve_pls(station["url"])
    log("play %s -> %s", station["id"], url)
    ipc("loadfile", url, "replace")
    ipc("set_property", "pause", False)
    s["station"] = station["id"]
    s["ducked"] = False
    s["preduck"] = None
    s["manual"] = True
    save_state(s)
    return s


def step(delta):
    s = load_state()
    order = order_ids(s)
    cur = s.get("station")
    idx = order.index(cur) if cur in order else -1
    nxt = order[(idx + delta) % len(order)]
    st = find_station(nxt) or stations()[0]
    play(st, s)
    return st


def now_playing():
    """Current track from ICY metadata, or None if it has not arrived yet.

    Right after a station switch mpv falls back to the URL basename for
    media-title, which is not a track name - suppress that.
    """
    try:
        path = ipc("get_property", "path") or ""
    except Exception:
        path = ""
    placeholder = path.rstrip("/").rsplit("/", 1)[-1].lower()
    for prop in ("metadata/by-key/icy-title", "media-title"):
        try:
            v = ipc("get_property", prop)
        except Exception:
            continue
        if not v or not isinstance(v, str):
            continue
        v = v.strip()
        if not v or v.startswith("http") or v.lower() == placeholder:
            continue
        return v
    return None


def set_volume(vol, s=None):
    s = s or load_state()
    vol = max(0, min(VOL_MAX, int(vol)))
    try:
        ipc("set_property", "volume", vol)
    except NotRunning:
        pass
    s["volume"] = vol
    save_state(s)
    return vol


# --------------------------------------------------------------------------
# output
# --------------------------------------------------------------------------

def die(msg):
    sys.stderr.write("ccradio: %s\n" % msg)
    sys.exit(1)


def say(msg):
    sys.stdout.write(msg + "\n")


def describe(s=None):
    s = s or load_state()
    st = find_station(s["station"]) if s.get("station") else None
    if not alive():
        if not shutil.which("mpv"):
            return ("mpv is not installed - no audio. Install it with: %s"
                    % ("brew install mpv" if sys.platform == "darwin"
                       else "sudo apt install mpv"))
        return "stopped"
    bits = []
    try:
        paused = ipc("get_property", "pause")
    except Exception:
        paused = False
    bits.append("paused" if paused else "playing")
    if st:
        bits.append(st["name"])
    track = now_playing()
    if track:
        bits.append(track)
    # Report mpv's real volume, not the stored setting - they differ while ducked.
    try:
        vol = int(ipc("get_property", "volume"))
    except Exception:
        vol = s["volume"]
    bits.append("vol %d%s" % (vol, " (ducked)" if s.get("ducked") else ""))
    return "  |  ".join(bits)


# --------------------------------------------------------------------------
# search
# --------------------------------------------------------------------------

def rb_server():
    try:
        req = urllib.request.Request(
            "https://all.api.radio-browser.info/json/servers",
            headers={"User-Agent": UA})
        servers = json.loads(urllib.request.urlopen(req, timeout=10).read())
        names = sorted({s["name"] for s in servers if s.get("name")})
        if names:
            return random.choice(names)
    except Exception:
        pass
    return "de1.api.radio-browser.info"


def search(term, limit=20):
    host = rb_server()
    q = urllib.parse.urlencode(
        {"name": term, "limit": limit, "hidebroken": "true", "order": "clickcount",
         "reverse": "true"})
    url = "https://%s/json/stations/search?%s" % (host, q)
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    return json.loads(urllib.request.urlopen(req, timeout=15).read())


def save_found(results):
    """Stash search hits so `ccradio play <n>` can reach them."""
    with open(os.path.join(state_dir(), "found.json"), "w") as fh:
        json.dump(results, fh)


def load_found():
    try:
        with open(os.path.join(state_dir(), "found.json")) as fh:
            return json.load(fh)
    except Exception:
        return []


# --------------------------------------------------------------------------
# genre and language pools
# --------------------------------------------------------------------------

# Radio Browser tags worth suggesting. Not a whitelist - any tag it knows works.
GENRE_PRESETS = (
    "lofi", "jazz", "classical", "ambient", "electronic", "rock", "metal",
    "hip hop", "blues", "funk", "soul", "reggae", "folk", "techno", "piano",
    "bollywood", "carnatic", "ghazal",
)


def pool_path():
    return os.path.join(state_dir(), "pool.json")


def read_pool():
    """The genre or language pool you picked, or None for the built-ins."""
    try:
        with open(pool_path()) as fh:
            pool = json.load(fh)
        if pool.get("stations"):
            return pool
    except Exception:
        pass
    return None


def write_pool(label, sts):
    tmp = pool_path() + ".%d.tmp" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump({"label": label, "stations": sts}, fh)
    os.replace(tmp, pool_path())


def drop_pool():
    try:
        os.unlink(pool_path())
    except OSError:
        pass


def pool_id(name, taken):
    """A readable id for a fetched station, unique within its own pool."""
    base = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:20] or "station"
    out, n = base, 2
    while out in taken:
        out, n = "%s-%d" % (base, n), n + 1
    taken.add(out)
    return out


def as_station(rec, taken):
    """Reshape a Radio Browser record into what stations() hands out."""
    name = (rec.get("name") or "").strip() or "unnamed"
    return {
        "id": pool_id(name, taken),
        "name": name,
        "genre": (rec.get("tags") or "").replace(",", ", ")[:44],
        "url": rec.get("url_resolved") or rec.get("url"),
        "source": "Radio Browser",
        "homepage": rec.get("homepage") or "",
    }


def rb_fetch(field, term, limit=30):
    """Stations matching one Radio Browser field - 'tag' or 'language'."""
    q = urllib.parse.urlencode(
        {field: term, "limit": limit, "hidebroken": "true",
         "order": "clickcount", "reverse": "true"})
    url = "https://%s/json/stations/search?%s" % (rb_server(), q)
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    recs = json.loads(urllib.request.urlopen(req, timeout=15).read())
    taken, out = set(), []
    for rec in recs:
        if rec.get("url_resolved") or rec.get("url"):
            out.append(as_station(rec, taken))
    return out


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def cmd_play(args):
    s = load_state()
    if args:
        key = " ".join(args)
        if key.isdigit():
            found = load_found()
            i = int(key) - 1
            if not (0 <= i < len(found)):
                die("no search result %s - run: ccradio search <term>" % key)
            r = found[i]
            st = {"id": "rb-" + r["stationuuid"][:8], "name": r["name"].strip(),
                  "genre": r.get("tags", ""), "url": r.get("url_resolved") or r["url"],
                  "source": "Radio Browser"}
        else:
            st = find_station(key)
            if not st:
                die("no station matching '%s' - try: ccradio stations" % key)
    else:
        st = find_station(s["station"]) if s.get("station") else stations()[0]
    play(st, s)
    say("> %s  (%s)" % (st["name"], st.get("genre") or st.get("source", "")))


def cmd_next(_):
    st = step(1)
    say("> %s  (%s)" % (st["name"], st.get("genre", "")))


def cmd_prev(_):
    st = step(-1)
    say("> %s  (%s)" % (st["name"], st.get("genre", "")))


def cmd_shuffle(_):
    s = load_state()
    order = order_ids(s)
    random.shuffle(order)
    s["order"] = order
    s["shuffle"] = True
    save_state(s)
    st = find_station(order[0])
    play(st, s)
    say("~ shuffled %d stations" % len(order))
    say("> %s  (%s)" % (st["name"], st.get("genre", "")))


def cmd_pause(_):
    if not alive():
        die("not playing - run: ccradio play")
    ipc("cycle", "pause")
    paused = ipc("get_property", "pause")
    say("|| paused" if paused else "> resumed")


def cmd_vol(args):
    s = load_state()
    if not args:
        say("vol %d" % s["volume"])
        return
    a = args[0].lower()
    if a in ("up", "+"):
        v = set_volume(s["volume"] + VOL_STEP, s)
    elif a in ("down", "-"):
        v = set_volume(s["volume"] - VOL_STEP, s)
    elif a.lstrip("-").isdigit():
        v = set_volume(int(a), s)
    else:
        die("usage: ccradio vol [up|down|<0-%d>]" % VOL_MAX)
    say("vol %d" % v)


def cmd_now(_):
    if not alive():
        die("not playing - run: ccradio play")
    track = now_playing()
    st = find_station(load_state().get("station"))
    say("%s%s" % (track or "(no track metadata)",
                  "  --  %s" % st["name"] if st else ""))


def cmd_status(_):
    say(describe())


def cmd_statusline(args):
    """One compact segment for the Claude Code statusline.

    Prints nothing when the radio is off, so the statusline stays clean.
    Must never fail or hang - the statusline runs on every render.
    """
    width = 46
    for a in args:
        if a.startswith("--width="):
            width = max(12, int(a.split("=", 1)[1]))
    try:
        if not alive():
            return
        paused = bool(ipc("get_property", "pause", timeout=0.4))
        st = find_station(load_state().get("station"))
        name = st["name"] if st else "radio"
        track = None if paused else now_playing()
        seg = ("%s %s" % ("||" if paused else "\u266a", name))
        if track:
            seg += " \u00b7 " + track
        if len(seg) > width:
            seg = seg[:width - 1].rstrip() + "\u2026"
        say(seg)
    except Exception:
        return


def cmd_stations(_):
    s = load_state()
    cur = s.get("station")
    pool = read_pool()
    if pool:
        kind = pool["label"].split(":", 1)[0]
        say("%s - ccradio %s off for the built-ins\n" % (pool["label"], kind))
    for st in stations():
        mark = "*" if st["id"] == cur else " "
        # Clipped: a fetched pool carries names far longer than the built-ins.
        say("%s %-22.22s %-26.26s %.34s" % (
            mark, st["id"], st["name"], st.get("genre", "")))


def cmd_search(args):
    if not args:
        die("usage: ccradio search <term>")
    res = search(" ".join(args))
    if not res:
        say("no stations found")
        return
    save_found(res)
    for i, r in enumerate(res, 1):
        say("%2d. %-34s %-8s %-6s %s" % (
            i, r["name"].strip()[:34], (r.get("countrycode") or "")[:8],
            "%skbps" % r.get("bitrate", "?"), (r.get("tags") or "")[:36]))
    say("\nplay one with: ccradio play <number>")


OFF_WORDS = ("off", "clear", "none", "reset", "default", "built-in", "builtin")


def set_pool(field, word, args):
    """Shared body of `ccradio genre` and `ccradio language`."""
    term = " ".join(args).strip()
    if not term:
        pool = read_pool()
        say("now playing from: %s" % (pool["label"] if pool else
                                      "the built-in stations"))
        if word == "genre":
            say("\ntry one of: %s" % ", ".join(GENRE_PRESETS))
            say("or any tag Radio Browser knows.")
        else:
            say("\nany language Radio Browser knows: tamil, hindi, malayalam,"
                " telugu, french, japanese ...")
        say("\n  ccradio %s <name>   switch to it" % word)
        say("  ccradio %s off      back to the built-ins" % word)
        return
    if term.lower() in OFF_WORDS:
        drop_pool()
        s = load_state()
        s["order"] = []
        save_state(s)
        say("back to the built-in stations")
        return
    sts = rb_fetch(field, term)
    if not sts:
        die("nothing found for %s '%s'. See: ccradio %s" % (word, term, word))
    write_pool("%s: %s" % (word, term), sts)
    s = load_state()
    s["order"] = []
    save_state(s)
    say("%s: %s  (%d stations)" % (word, term, len(sts)))
    play(random.choice(sts), s)


def cmd_genre(args):
    """Play a genre, and keep the automatic music inside it."""
    set_pool("tag", "genre", args)


def cmd_language(args):
    """Play a language, and keep the automatic music inside it."""
    set_pool("language", "language", args)


def cmd_debug(args):
    """Show the trace log, or explain how to turn it on."""
    path = os.path.join(state_dir(), "debug.log")
    if args and args[0] in ("clear", "reset"):
        for f in (path, path + ".1"):
            try:
                os.unlink(f)
            except OSError:
                pass
        say("log cleared")
        return
    if not os.environ.get("CCRADIO_DEBUG") and not os.path.exists(path):
        say("Tracing is off, so nothing has been recorded.\n")
        say("Hooks run detached with their output discarded, so a radio that")
        say("stays quiet leaves nothing to go on. Turn tracing on to see why:\n")
        say('  echo \'{"env": {"CCRADIO_DEBUG": "1"}}\' # add CCRADIO_DEBUG=1 to')
        say("  # the env block of ~/.claude/settings.json, then restart Claude Code\n")
        say("  ccradio debug          read the trace")
        say("  ccradio debug clear    start it over")
        return
    if not os.path.exists(path):
        say("Tracing is on, but nothing is recorded yet. Send a prompt first.")
        return
    n = 40
    if args and args[0].lstrip("-").isdigit():
        n = abs(int(args[0]))
    with open(path) as fh:
        lines = fh.read().splitlines()
    for line in lines[-n:]:
        say(line)
    if not os.environ.get("CCRADIO_DEBUG"):
        say("\n(tracing is off now - this is an older log)")


def cmd_start(_):
    start_daemon()
    say("daemon up")


def cmd_stop(_):
    s = load_state()
    s["manual"] = False
    save_state(s)
    stop_daemon()
    say("stopped")


def is_playing():
    """True only if the daemon is up and not paused."""
    try:
        return not ipc("get_property", "pause")
    except Exception:
        return False


# --------------------------------------------------------------------------
# the working signal: music plays while ANY tab is working, and only then
# --------------------------------------------------------------------------

START_DELAY = 6.0        # seconds of work before the music earns its place
STALE_AFTER = 7200.0     # forget a tab that never reported finishing (2h)


def working_path():
    return os.path.join(state_dir(), "working.json")


@contextlib.contextmanager
def locked():
    """Serialise read-modify-write across tabs.

    Without this, two tabs arming at the same instant both read the old set
    and one write is lost - leaving a tab that is working but invisible, so
    the music stops while it is still going.
    """
    fh = open(os.path.join(state_dir(), "lock"), "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fh, fcntl.LOCK_UN)
        finally:
            fh.close()


def read_working():
    """Map of session_id -> when it started working, minus stale entries."""
    try:
        with open(working_path()) as fh:
            w = json.load(fh)
    except Exception:
        return {}
    now = time.time()
    return {k: v for k, v in w.items()
            if isinstance(v, (int, float)) and now - v < STALE_AFTER}


def write_working(w):
    tmp = working_path() + ".%d.tmp" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump(w, fh)
    os.replace(tmp, working_path())


def session_id():
    """Which tab is this hook from? Claude Code sends session_id on stdin."""
    sid = os.environ.get("CLAUDE_SESSION_ID")
    if sid:
        return sid
    if not sys.stdin.isatty():
        try:
            raw = sys.stdin.read(65536)
            if raw.strip():
                sid = json.loads(raw).get("session_id")
                if sid:
                    return str(sid)
        except Exception:
            pass
    # Last resort: one bucket per terminal, so tabs still differ.
    return "tty-%s" % (os.environ.get("TERM_SESSION_ID") or os.getppid())


def cmd_arm(_):
    """UserPromptSubmit: this tab started working.

    Music starts only if no tab was already working - a second tab joining
    must not stomp the station the first one is playing. Waits out
    START_DELAY first, so a quick answer stays silent.
    """
    sid = session_id()
    with locked():
        w = read_working()
        was_idle = not w
        w[sid] = time.time()
        write_working(w)
    # You just sent a prompt, so you are back: undo any duck we applied.
    cmd_unduck([])
    log("arm %s (was_idle=%s, working=%d)", sid[:8], was_idle, len(w))
    if not was_idle:
        return                       # music already going for another tab
    if os.fork() != 0:
        return                       # parent returns to the hook at once
    os.setsid()
    time.sleep(START_DELAY)
    try:
        with locked():               # one starter at a time, or we spawn two mpvs
            if sid not in read_working():
                log("arm %s: turn ended inside the delay, staying quiet", sid[:8])
                os._exit(0)          # this tab finished - stay quiet
            try:
                if not ipc("get_property", "idle-active"):
                    log("arm %s: a station is already loaded, leaving it", sid[:8])
                    os._exit(0)      # a station is already loaded - don't stomp it
            except Exception:
                pass                 # no daemon yet - ours to start
            s = load_state()
            pool = [x for x in stations() if x["id"] != s.get("station")] or stations()
            s = play(random.choice(pool), s)
            s["manual"] = False      # the hooks started this, so the hooks may stop it
            save_state(s)
    except SystemExit:
        raise
    except Exception as exc:
        log("arm %s: could not start music: %s: %s", sid[:8],
            type(exc).__name__, exc)
    os._exit(0)


def cmd_disarm(_):
    """Stop / SessionEnd: this tab finished. Silence only when ALL tabs are done."""
    sid = session_id()
    with locked():
        w = read_working()
        w.pop(sid, None)
        write_working(w)
    log("disarm %s (%d still working)", sid[:8], len(w))
    if w:
        return                       # another tab is still working - keep playing
    if load_state().get("manual"):
        log("disarm: music was started by hand, leaving it")
        return                       # you put this on yourself - not ours to stop
    stop_daemon()


def cmd_working(_):
    """Which tabs are working right now (debugging)."""
    w = read_working()
    if not w:
        say("no tab is working")
        return
    now = time.time()
    for sid, started in sorted(w.items(), key=lambda kv: kv[1]):
        say("%-40s %.0fs" % (sid, now - started))


def cmd_duck(_):
    """Notification / PermissionRequest: Claude needs you. Drop out of the way.

    Only for a real tab. Subagents fire their own idle Notifications under a
    separate session_id, and a subagent going idle is not you being asked for
    anything - ducking on those would dip the music at random.
    """
    sid = session_id()
    if sid not in read_working():
        log("duck from %s ignored: not a working tab (subagent?)", sid[:8])
        return
    s = load_state()
    if not alive():
        # A daemon that died while ducked leaves the flag set. Clear it, or it
        # swallows the next real duck and status reports a lie.
        log("duck from %s: no daemon running, nothing to duck", sid[:8])
        if s.get("ducked"):
            log("cleared a stale ducked flag left by a dead daemon")
            s["ducked"], s["preduck"] = False, None
            save_state(s)
        return
    try:
        current = int(ipc("get_property", "volume"))
    except Exception as exc:
        log("duck: could not read volume: %s", exc)
        return
    target = max(DUCK_FLOOR, int(s["volume"] * DUCK_RATIO))
    if s.get("ducked") and current <= target:
        log("duck: already at %d, nothing to do", current)
        return                       # genuinely ducked already
    # Trust mpv's volume, not the stored flag - the flag can go stale.
    s["preduck"] = current
    try:
        ipc("set_property", "volume", target)
    except Exception:
        return
    s["ducked"] = True
    save_state(s)
    log("ducked %d -> %d", current, target)


def cmd_unduck(_):
    s = load_state()
    if not s.get("ducked"):
        return
    try:
        ipc("set_property", "volume", s.get("preduck") or s["volume"])
    except Exception:
        pass
    s["ducked"] = False
    s["preduck"] = None
    save_state(s)


COMMANDS = {
    "play": cmd_play, "next": cmd_next, "prev": cmd_prev, "previous": cmd_prev,
    "shuffle": cmd_shuffle, "pause": cmd_pause, "resume": cmd_pause,
    "vol": cmd_vol, "volume": cmd_vol, "now": cmd_now, "status": cmd_status,
    "stations": cmd_stations, "list": cmd_stations, "search": cmd_search,
    "genre": cmd_genre, "language": cmd_language, "lang": cmd_language,
    "statusline": cmd_statusline, "debug": cmd_debug,
    "start": cmd_start, "stop": cmd_stop,
    "duck": cmd_duck, "unduck": cmd_unduck,
    "arm": cmd_arm, "disarm": cmd_disarm, "working": cmd_working,
}

USAGE = """ccradio - internet radio while Claude works

  play [station|N]   start, or switch to a station (N = search result)
  next / prev        move one station along
  shuffle            reshuffle the station order
  pause              pause or resume
  vol up|down|<n>    volume, 0-130 (mpv only, never system volume)
  now                current track
  status             what's playing right now
  working            which Claude Code tabs are working right now
  debug [n|clear]    trace log - why the radio did or didn't do something
  statusline         compact segment for the Claude Code statusline
  stations           list the stations in play
  genre [name|off]   play a genre, and keep the automatic music in it
  language [name]    same, by language
  search <term>      find more via Radio Browser
  stop               stop playback and the daemon
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    cmd = argv[0].lower()
    fn = COMMANDS.get(cmd)
    if not fn:
        die("unknown command '%s'. Try: ccradio help" % cmd)
    try:
        fn(argv[1:])
    except NotRunning:
        die("radio is not running - run: ccradio play")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
