#!/bin/sh
# Claude Code statusline wrapper: runs your existing statusline command, then
# appends the radio segment. Set YOUR_STATUSLINE to whatever you had before.
#
#   "statusLine": { "type": "command",
#                   "command": "/path/to/ccradio-statusline", "padding": 0 }
YOUR_STATUSLINE="${CCRADIO_BASE_STATUSLINE:-python3 $HOME/.config/ai-usage-widget/aiusage.py --statusline}"
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

payload="$(cat)"                      # statusline JSON arrives on stdin, read once
base="$(printf '%s' "$payload" | sh -c "$YOUR_STATUSLINE" 2>/dev/null)"
radio="$("$ROOT/bin/ccradio" statusline 2>/dev/null)"

if [ -n "$radio" ] && [ -n "$base" ]; then
  printf '%s  \033[2m|\033[0m  %s\n' "$base" "$radio"
else
  printf '%s%s\n' "$base" "$radio"
fi
